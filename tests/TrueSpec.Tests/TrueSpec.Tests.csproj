<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted because the app targets net10.0-windows on Windows
         and net10.0 elsewhere. A net10.0 project cannot reference a
         net10.0-windows app (NU1201), and restore evaluates every TFM even
         with -f, so the App reference is conditioned to the
         net10.0-windows leg only, and the tests that drive the App's
         ViewModels (ScoreAgreementTests) are excluded from the net10.0
         leg. Each OS then tests the framework that matches it (dotnet
         test -f net10.0-windows on Windows, -f net10.0 on Linux/macOS).
         EnableWindowsTargeting lets the net10.0-windows leg restore and
         build on Linux. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrueSpec.Core\TrueSpec.Core.csproj" />
    <!-- Windows leg only: on Windows the app targets net10.0-windows, and
         an unconditional reference makes restore evaluate the net10.0 leg
         against it (NU1201). The net10.0 leg tests Core only. -->
    <ProjectReference Include="..\..\src\TrueSpec.App\TrueSpec.App.csproj" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\..\src\TrueSpec.Collectors.Windows\TrueSpec.Collectors.Windows.csproj" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>

  <!-- ScoreAgreementTests, NavigationTests, HistoryForecastViewModelTests,
       HistoryValueComparisonViewModelTests,
       HistorySensorLogViewModelTests, LoadTestViewModelTests,
       SensorAlertViewModelTests, AdminNoticeViewModelTests and
       ExportConfirmationTests
       drive the App's ViewModels, so they only compile on the Windows leg.
       TestsViewModelTests, ComparisonViewModelTests,
       LiveMetricViewModelTests, ScanCancelTests and
       ShellExportFileOpenerTests do the same, and
       CollectorWmiSelectionTests drives the Windows collectors.
       MachineDnaVerificationTests and ReportViewModelTests drive the
       App's DNA seam and Report page; DriverAgeRuleTests drives the
       Windows collectors; FleetViewModelTests drives the Fleet page;
       ExportAllMachinesTests drives the App's export orchestrator.
       Excluding the files (rather
       than #if-ing them) keeps the tests readable and the exclusion visible
       in the project file. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="ScoreAgreementTests.cs" />
    <Compile Remove="HistoryForecastViewModelTests.cs" />
    <Compile Remove="HistoryValueComparisonViewModelTests.cs" />
    <Compile Remove="HistorySensorLogViewModelTests.cs" />
    <Compile Remove="HistoryRemoveScanViewModelTests.cs" />
    <Compile Remove="LoadTestViewModelTests.cs" />
    <Compile Remove="SensorAlertViewModelTests.cs" />
    <Compile Remove="AdminNoticeViewModelTests.cs" />
    <Compile Remove="ExportConfirmationTests.cs" />
    <Compile Remove="TestsViewModelTests.cs" />
    <Compile Remove="ComparisonViewModelTests.cs" />
    <Compile Remove="ComponentDetailViewModelTests.cs" />
    <Compile Remove="LiveMetricViewModelTests.cs" />
    <Compile Remove="ScanCancelTests.cs" />
    <Compile Remove="ShellExportFileOpenerTests.cs" />
    <Compile Remove="CollectorWmiSelectionTests.cs" />
    <Compile Remove="DriverSignatureSummaryTests.cs" />
    <Compile Remove="StartupCollectorTests.cs" />
    <Compile Remove="SoftwareCollectorTests.cs" />
    <Compile Remove="UpdatesCollectorTests.cs" />
    <Compile Remove="CollectorValueTests.cs" />
    <Compile Remove="StorageCollectorTests.cs" />
    <Compile Remove="CpuCollectorTests.cs" />
    <Compile Remove="RamCollectorTests.cs" />
    <Compile Remove="SystemCollectorTests.cs" />
    <Compile Remove="DisplayNetworkTruthTests.cs" />
    <Compile Remove="DriversCollectorTests.cs" />
    <Compile Remove="CrashCollectorTests.cs" />
    <Compile Remove="LoadTestIntegrationTests.cs" />
    <Compile Remove="V13IntegrationTests.cs" />
    <Compile Remove="NavigationTests.cs" />
    <Compile Remove="HistoryCsvTableAgreementTests.cs" />
    <Compile Remove="MachineDnaVerificationTests.cs" />
    <Compile Remove="ReportViewModelTests.cs" />
    <Compile Remove="DriverAgeRuleTests.cs" />
    <Compile Remove="FleetViewModelTests.cs" />
    <Compile Remove="ExportAllMachinesTests.cs" />
    <Compile Remove="SettingsViewModelTests.cs" />
  </ItemGroup>

</Project>