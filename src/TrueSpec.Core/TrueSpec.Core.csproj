<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <!-- The bundled hardware database (Beyond v2.0, item 5): a small,
       versioned JSON dataset of CPU model specifications, embedded so
       the lookup is 100% local and works offline. -->
  <ItemGroup>
    <EmbeddedResource Include="HardwareDatabase\hardware-database.json" />
  </ItemGroup>

  <!-- Tests cover the default-export-folder resolution (Downloads when it
       exists, Documents/TrueSpec otherwise) through the internal seam in
       PathSafety, so the test assembly can see internals. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrueSpec.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
