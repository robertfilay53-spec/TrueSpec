<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="11.0.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

  <!-- Tests cover the internal SMART reader's drive-number guard, so the
       test assembly can see internals. The guard is the P/Invoke boundary:
       it must reject out-of-range drive numbers before any device path is
       built. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrueSpec.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueSpec.Core\TrueSpec.Core.csproj" />
  </ItemGroup>

</Project>
