<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:controls="using:TrueSpec.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="HISTORY" Classes="eyebrow" />
                <TextBlock Text="How this machine changes over time" Classes="h1" />
                <TextBlock Text="{Binding MachineSubtitleText}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
                <TextBlock Text="Every scan is saved to a local database on this machine. TrueSpec trends the overall score, battery health and storage wear across those scans. A value a scan did not report is a gap, never a zero."
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Machine" Classes="h3" />
                    <ComboBox ItemsSource="{Binding MachineNames}"
                              SelectedItem="{Binding SelectedMachine}"
                              IsEnabled="{Binding IsMachinePickerEnabled}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Pick a machine" />
                    <TextBlock Text="History is shown for one machine at a time. Pick another machine to see its own trend."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" IsVisible="{Binding HasHistory}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasBatteryAlert}">
                <StackPanel Spacing="8">
                    <TextBlock Text="BATTERY HEALTH ALERT" Classes="eyebrow" />
                    <TextBlock Text="{Binding BatteryAlertText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding HasHistory}">
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Overall score" Classes="h3" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding ScoreValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding ScoreRangeText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Battery health" Classes="h3" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding BatteryHealthValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding BatteryRangeText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="FORECAST" Classes="eyebrow" IsVisible="{Binding HasBatteryForecast}" />
                        <TextBlock Text="{Binding BatteryForecastText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasBatteryForecast}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage wear" Classes="h3" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding StorageWearValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding WearRangeText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="FORECAST" Classes="eyebrow" IsVisible="{Binding HasStorageWearForecast}" />
                        <TextBlock Text="{Binding StorageWearForecastText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasStorageWearForecast}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock Text="CPU temperature log" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="Refresh chart"
                                Command="{Binding RefreshSensorLogCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SensorLogStatusText}" Classes="muted" TextWrapping="Wrap" />
                    <controls:SensorLogChart Height="120"
                                             Values="{Binding CpuTemperatureLogValues}"
                                             ThresholdValue="{Binding SensorLogThresholdC}"
                                             StrokeThickness="2"
                                             IsVisible="{Binding HasSensorLog}" />
                    <TextBlock Text="{Binding SensorLogSummaryText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasSensorLog}" />
                    <TextBlock Text="Gaps in the line are samples where the CPU temperature sensor did not report. The line never connects across a gap. The dashed line is your alert threshold, when one is set. The log is a local CSV under %LocalAppData%\TrueSpec; nothing is uploaded."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasSensorLog}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasDriverAgeSummary}">
                <StackPanel Spacing="8">
                    <TextBlock Text="DRIVER AGE" Classes="eyebrow" />
                    <TextBlock Text="{Binding DriverAgeSummaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasHistory}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock Text="Saved scans" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="Export history as CSV"
                                Command="{Binding ExportHistoryCsvCommand}"
                                IsEnabled="{Binding HasHistory}" />
                    </Grid>
                    <TextBlock Text="Oldest first. A dash means that scan did not report the value."
                               Classes="muted"
                               FontSize="11" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid ColumnDefinitions="150,70,110,80,110,*" ColumnSpacing="10">
                                        <TextBlock Text="{Binding CapturedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScoreText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding BatteryHealthText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding BatteryCyclesText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding StorageWearText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding StorageHoursText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="150,70,110,80,110,*" ColumnSpacing="10">
                        <TextBlock Text="Scanned" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Score" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="Battery health" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="Cycles" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="Storage wear" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="5" Text="Power-on hours" Classes="muted" FontSize="11" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Compare two machines" Classes="h3" />
                    <TextBlock Text="Different machines — shown side by side, never mixed in one trend."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Machine A" Classes="h3" />
                            <ComboBox ItemsSource="{Binding MachineNames}"
                                      SelectedItem="{Binding CompareMachineA}"
                                      IsEnabled="{Binding IsMachinePickerEnabled}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Pick a machine" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Machine B" Classes="h3" />
                            <ComboBox ItemsSource="{Binding MachineNames}"
                                      SelectedItem="{Binding CompareMachineB}"
                                      IsEnabled="{Binding IsMachinePickerEnabled}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Pick a machine" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="primary"
                                Content="Compare"
                                Command="{Binding CompareMachinesCommand}"
                                IsEnabled="{Binding CanCompareMachines}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding ComparisonStatusText}" Classes="muted" TextWrapping="Wrap" />

                    <StackPanel Spacing="10" IsVisible="{Binding HasMachineComparison}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <TextBlock Text="" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MachineAName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MachineBName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ComparisonRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MachineComparisonRowViewModel">
                                    <Border BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,9">
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Label}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MachineAText}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding MachineBText}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Which one is the better buy?" Classes="h3" />
                        <TextBlock Text="Type in each seller's asking price. The price is yours, not measured, and it is only used for this comparison. It is never saved with the scan."
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding MachineAName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Asking price (you enter this, not measured)" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                <TextBox Text="{Binding PriceAText}"
                                         PlaceholderText="For example 500"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding MachineBName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Asking price (you enter this, not measured)" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                <TextBox Text="{Binding PriceBText}"
                                         PlaceholderText="For example 500"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Button Classes="primary"
                                Content="Compare value"
                                Command="{Binding CompareValueCommand}"
                                IsEnabled="{Binding CanCompareValue}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ValueStatusText}" Classes="muted" TextWrapping="Wrap" />

                        <StackPanel Spacing="10" IsVisible="{Binding HasValueComparison}">
                            <TextBlock Text="{Binding ValueVerdictText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ValueRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MachineComparisonRowViewModel">
                                        <Border BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Label}"
                                                           Classes="muted"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MachineAText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding MachineBText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Per-component winner (measured health only)" Classes="h3" />
                            <ItemsControl ItemsSource="{Binding ValueComponentWinners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ValueWinnerRowViewModel">
                                        <Border BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <TextBlock Text="{Binding ComponentName}"
                                                           Classes="muted"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WinnerText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
