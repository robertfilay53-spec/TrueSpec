<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:controls="using:TrueSpec.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding HistoryEyebrowText}" Classes="eyebrow" />
                <TextBlock Text="{Binding HistoryTitleText}" Classes="h1" />
                <TextBlock Text="{Binding MachineSubtitleText}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
                <TextBlock Text="{Binding HistoryIntroText}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding HistoryMachineTitleText}" Classes="h3" />
                    <ComboBox ItemsSource="{Binding MachineNames}"
                              SelectedItem="{Binding SelectedMachine}"
                              IsEnabled="{Binding IsMachinePickerEnabled}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{Binding HistoryPickMachineText}" />
                    <TextBlock Text="{Binding HistoryMachineNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" IsVisible="{Binding HasHistory}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasBatteryAlert}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding HistoryBatteryAlertEyebrowText}" Classes="eyebrow" />
                    <TextBlock Text="{Binding BatteryAlertText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding HasHistory}">
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding HistoryScoreTitleText}" Classes="h3" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding ScoreValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding ScoreRangeText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding HistoryBatteryTitleText}" Classes="h3" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding BatteryHealthValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding BatteryRangeText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HistoryForecastEyebrowText}" Classes="eyebrow" IsVisible="{Binding HasBatteryForecast}" />
                        <TextBlock Text="{Binding BatteryForecastText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasBatteryForecast}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding HistoryWearTitleText}" Classes="h3" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding StorageWearValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding WearRangeText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HistoryForecastEyebrowText}" Classes="eyebrow" IsVisible="{Binding HasStorageWearForecast}" />
                        <TextBlock Text="{Binding StorageWearForecastText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasStorageWearForecast}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock Text="{Binding HistoryCpuLogTitleText}" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{Binding HistoryRefreshChartText}"
                                Command="{Binding RefreshSensorLogCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SensorLogStatusText}" Classes="muted" TextWrapping="Wrap" />
                    <controls:SensorLogChart Height="120"
                                             Segments="{Binding CpuTemperatureLogSegments}"
                                             ThresholdValue="{Binding SensorLogThresholdC}"
                                             StrokeThickness="2"
                                             IsVisible="{Binding HasSensorLog}" />
                    <TextBlock Text="{Binding SensorLogSummaryText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasSensorLog}" />
                    <TextBlock Text="{Binding HistoryChartCaptionText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasSensorLog}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasDriverAgeSummary}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding HistoryDriverAgeEyebrowText}" Classes="eyebrow" />
                    <TextBlock Text="{Binding DriverAgeSummaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasHistory}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock Text="{Binding HistorySavedScansTitleText}" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{Binding HistoryExportCsvText}"
                                Command="{Binding ExportHistoryCsvCommand}"
                                IsEnabled="{Binding HasHistory}" />
                    </Grid>
                    <TextBlock Text="{Binding HistoryTableNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid ColumnDefinitions="150,70,110,80,110,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding CapturedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScoreText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding BatteryHealthText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding BatteryCyclesText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding StorageWearText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding StorageHoursText}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="6"
                                                Classes="secondary"
                                                Content="{Binding RemoveButtonText}"
                                                FontSize="11"
                                                Command="{Binding RemoveScanCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="150,70,110,80,110,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding HistoryHeaderScannedText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding HistoryHeaderScoreText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{Binding HistoryHeaderBatteryText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="{Binding HistoryHeaderCyclesText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="{Binding HistoryHeaderWearText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="5" Text="{Binding HistoryHeaderPowerOnHoursText}" Classes="muted" FontSize="11" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding HistoryCompareTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding HistoryCompareNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding HistoryMachineAText}" Classes="h3" />
                            <ComboBox ItemsSource="{Binding MachineNames}"
                                      SelectedItem="{Binding CompareMachineA}"
                                      IsEnabled="{Binding IsMachinePickerEnabled}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="{Binding HistoryPickMachineText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding HistoryMachineBText}" Classes="h3" />
                            <ComboBox ItemsSource="{Binding MachineNames}"
                                      SelectedItem="{Binding CompareMachineB}"
                                      IsEnabled="{Binding IsMachinePickerEnabled}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="{Binding HistoryPickMachineText}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="primary"
                                Content="{Binding HistoryCompareButtonText}"
                                Command="{Binding CompareMachinesCommand}"
                                IsEnabled="{Binding CanCompareMachines}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding ComparisonStatusText}" Classes="muted" TextWrapping="Wrap" />

                    <StackPanel Spacing="10" IsVisible="{Binding HasMachineComparison}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <TextBlock Text="" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MachineAName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MachineBName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ComparisonRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MachineComparisonRowViewModel">
                                    <Border BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,9">
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Label}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MachineAText}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding MachineBText}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding HistoryValueTitleText}" Classes="h3" />
                        <TextBlock Text="{Binding HistoryValueIntroText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding MachineAName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HistoryAskingPriceLabelText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                <TextBox Text="{Binding PriceAText}"
                                         PlaceholderText="{Binding HistoryPriceExampleText}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding MachineBName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HistoryAskingPriceLabelText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                <TextBox Text="{Binding PriceBText}"
                                         PlaceholderText="{Binding HistoryPriceExampleText}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Button Classes="primary"
                                Content="{Binding HistoryCompareValueButtonText}"
                                Command="{Binding CompareValueCommand}"
                                IsEnabled="{Binding CanCompareValue}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ValueStatusText}" Classes="muted" TextWrapping="Wrap" />

                        <StackPanel Spacing="10" IsVisible="{Binding HasValueComparison}">
                            <TextBlock Text="{Binding ValueVerdictText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ValueRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MachineComparisonRowViewModel">
                                        <Border BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Label}"
                                                           Classes="muted"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MachineAText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding MachineBText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding HistoryWinnersTitleText}" Classes="h3" />
                            <ItemsControl ItemsSource="{Binding ValueComponentWinners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ValueWinnerRowViewModel">
                                        <Border BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <TextBlock Text="{Binding ComponentName}"
                                                           Classes="muted"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WinnerText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
