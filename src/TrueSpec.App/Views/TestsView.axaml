<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:controls="using:TrueSpec.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.TestsView"
             x:DataType="vm:TestsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding TestsEyebrowText}" Classes="eyebrow" />
                <TextBlock Text="{Binding TestsTitleText}" Classes="h1" />
                <TextBlock Text="{Binding TestsIntroText}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card" Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Ellipse Width="9" Height="9"
                             Fill="{DynamicResource WatchBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TestsInfoNoteText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding BenchmarkScopeNote}"
                       Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxWidth="720" />

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="10" DataContext="{Binding LoadTest}">
                    <TextBlock Text="{Binding LoadTestTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding LoadTestIntroText}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               MaxWidth="620" />
                    <TextBlock Text="{Binding WarningText}"
                               TextWrapping="Wrap"
                               MaxWidth="620" />
                    <TextBlock Text="{Binding FunctionalCheckText}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               MaxWidth="620" />
                    <TextBlock Text="{Binding LoadTestBatteryNoteText}"
                               TextWrapping="Wrap"
                               MaxWidth="620"
                               IsVisible="{Binding IsOnBattery}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding LoadTestDurationLabelText}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Durations}"
                                  SelectedItem="{Binding SelectedDurationSeconds}"
                                  IsEnabled="{Binding CanStart}"
                                  MinWidth="90" />
                        <Button Classes="secondary"
                                Content="{Binding LoadTestStartText}"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding CanStart}" />
                        <Button Classes="secondary"
                                Content="{Binding LoadTestCancelText}"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding CanCancel}" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
                        <TextBlock Text="{Binding LiveTemperatureText}" Classes="muted" />
                        <TextBlock Text="{Binding LiveClockText}" Classes="muted" />
                        <TextBlock Text="{Binding ElapsedText}" Classes="muted" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
                        <TextBlock Text="{Binding StatusText}" Classes="h3" />
                        <TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" MaxWidth="620" />
                        <TextBlock Text="{Binding ResultPeakText}" Classes="muted" />
                        <TextBlock Text="{Binding ResultClockText}" Classes="muted" />
                        <TextBlock Text="{Binding ResultRatedMaxText}" Classes="muted" />
                        <TextBlock Text="{Binding ResultPercentText}" Classes="muted" />
                        <TextBlock Text="{Binding LoadTestFanHealthTitleText}" Classes="h3" />
                        <TextBlock Text="{Binding FanHealthSummaryText}" TextWrapping="Wrap" MaxWidth="620" />
                        <ItemsControl ItemsSource="{Binding FanHealthLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" MaxWidth="620" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding FanHealthFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LoadTestFanHealthNoteText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxWidth="620" />
                        <controls:Sparkline Height="52"
                                            Values="{Binding TemperatureValues}"
                                            StrokeThickness="2" />
                        <TextBlock Text="{Binding LoadTestTemperatureCaptionText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxWidth="620" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TestItemViewModel">
                        <Border Classes="card" Padding="18" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Name}" Classes="h3" />
                                    <TextBlock Text="{Binding Description}"
                                               Classes="muted"
                                               TextWrapping="Wrap"
                                               MaxWidth="620" />
                                    <TextBlock Text="{Binding ResultText}"
                                               Classes="muted"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxWidth="620" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource CardBackgroundAlt}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="12,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" />
                                </Border>
                                <Button Grid.Column="2"
                                        Classes="secondary"
                                        Content="{Binding RunButtonText}"
                                        Command="{Binding RunCommand}"
                                        IsEnabled="{Binding CanRunNow}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
