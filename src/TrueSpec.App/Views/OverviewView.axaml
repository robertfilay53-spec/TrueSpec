<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:controls="using:TrueSpec.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <!-- Admin notice: a standard-user scan with silent admin-gated
                 readings (disk wear, CPU/GPU temperature) says so plainly
                 instead of leaving blank cards unexplained. -->
            <Border Classes="card" Padding="18" IsVisible="{Binding HasAdminNotice}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding AdminEyebrowText}" Classes="eyebrow" />
                    <TextBlock Text="{Binding AdminNoticeText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Hero strip -->
            <Border Classes="hero" Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="26">
                    <Grid Width="136" Height="136" VerticalAlignment="Center">
                        <controls:ScoreRing Value="{Binding Score}"
                                            Thickness="12"
                                            RingBrush="{Binding VerdictStatus, Converter={StaticResource StatusBrush}}"
                                            TrackBrush="{DynamicResource ScoreTrack}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ScoreText}"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding OutOf100Text}"
                                       FontSize="11"
                                       Classes="muted"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding MachineName}" Classes="eyebrow" />
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VerdictText}" Classes="h1" VerticalAlignment="Center" />
                                <Border Background="{Binding VerdictStatus, Converter={StaticResource StatusTint}}"
                                        CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallHealthText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding VerdictStatus, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ScoreExplanation}"
                                       Classes="muted"
                                       TextWrapping="Wrap"
                                       MaxWidth="560" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ScoreBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScoreBreakdownRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7"
                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Component}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding HealthText}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding WeightText}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding ContributionText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ScoreNoteText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding KeyStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyStatViewModel">
                                    <Border Background="{DynamicResource CardBackgroundAlt}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,10,10"
                                            MinWidth="132">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Source}"
                                                       Classes="muted"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10" Width="190">
                        <Button Classes="primary"
                                Content="{Binding NewLaptopCheckText}"
                                Command="{Binding NewLaptopCheckCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Classes="secondary"
                                Content="{Binding ExportReportText}"
                                Command="{Binding ExportCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Component cards -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ComponentHealthText}" Classes="h2" />
                <TextBlock Grid.Column="1"
                           Text="{Binding OperatingSystem}"
                           Classes="muted"
                           VerticalAlignment="Center"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding OperatingSystem}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentCardViewModel">
                        <Border Classes="card" Width="292" Margin="0,0,14,14" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Width="34" Height="34" CornerRadius="9"
                                            Background="{DynamicResource CardBackgroundAlt}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1">
                                        <PathIcon Width="16" Height="16"
                                                  Data="{Binding IconData, Converter={StaticResource Geometry}}"
                                                  Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Classes="h3"
                                               VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="2"
                                             Width="9" Height="9"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                             VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding Headline}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MinHeight="40" />

                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding HealthLabelText}" Classes="muted" FontSize="11" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HealthText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Grid>
                                    <ProgressBar Classes="health"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding HealthValue}"
                                                 Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>

                                <Button Classes="link"
                                        Content="{Binding DetailsText}"
                                        Command="{Binding DetailsCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card" Padding="18" IsVisible="{Binding !HasComponents}">
                <TextBlock Text="{Binding NoComponentsText}"
                           Classes="muted"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Live strip -->
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding LiveSensorsText}" Classes="h3" />
                            <TextBlock Text="{Binding RefreshText}"
                                       Classes="muted"
                                       FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   Classes="muted"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding StatusMessage}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding LiveMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LiveMetricViewModel">
                                <Border Background="{DynamicResource CardBackgroundAlt}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,10,0">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CurrentText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <controls:Sparkline Height="52"
                                                            Values="{Binding Values}"
                                                            Stroke="{Binding Stroke}"
                                                            Fill="{Binding Fill}"
                                                            StrokeThickness="2"
                                                            IsVisible="{Binding HasValue}" />
                                        <TextBlock Text="{Binding NoSensorReadingText}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   Height="52"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasValue}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SensorLogText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AlertSettingsText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasSensorAlert}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding AlertEyebrowText}" Classes="eyebrow" />
                    <ItemsControl ItemsSource="{Binding SensorAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AlertNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding FooterText}"
                       Classes="muted"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
