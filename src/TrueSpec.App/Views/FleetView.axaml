<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.FleetView"
             x:DataType="vm:FleetViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding FleetEyebrowText}" Classes="eyebrow" />
                <TextBlock Text="{Binding FleetTitleText}" Classes="h1" />
                <TextBlock Text="{Binding FleetIntroText}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" IsVisible="{Binding HasFleet}" />
                    <Button Classes="secondary"
                            Content="{Binding FleetImportButtonText}"
                            Command="{Binding ImportReportsCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding FleetImportNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="720" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasFleet}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <TextBlock Text="{Binding FleetMachinesTitleText}" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{Binding FleetExportAllButtonText}"
                                Command="{Binding ExportAllMachinesCommand}"
                                IsEnabled="{Binding HasFleet}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="{Binding FleetExportFleetCsvButtonText}"
                                Command="{Binding ExportFleetCsvCommand}"
                                IsEnabled="{Binding HasFleet}" />
                    </Grid>
                    <TextBlock Text="{Binding FleetTableNoteText}"
                               Classes="muted"
                               FontSize="11" />
                    <Grid ColumnDefinitions="*,60,130,70,110,*,100,110" ColumnSpacing="10">
                        <TextBlock Text="{Binding FleetHeaderMachineText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding FleetHeaderScansText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{Binding FleetHeaderLastScanText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="{Binding FleetHeaderScoreText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="{Binding FleetHeaderVerdictText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="5" Text="{Binding FleetHeaderWorstComponentText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="6" Text="{Binding FleetHeaderExportText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="7" Text="{Binding FleetHeaderRemoveText}" Classes="muted" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FleetRowViewModel">
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid ColumnDefinitions="*,60,130,70,110,*,100,110" ColumnSpacing="10">
                                        <TextBlock Text="{Binding MachineName}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScanCountText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding LastScanText}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ScoreText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding VerdictText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding WorstComponentText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="6"
                                                Classes="secondary"
                                                Content="{Binding ExportButtonText}"
                                                FontSize="11"
                                                Command="{Binding ExportMachineCsvCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="7"
                                                Classes="secondary"
                                                Content="{Binding RemoveButtonText}"
                                                FontSize="11"
                                                Command="{Binding RemoveMachineCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
