<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.FleetView"
             x:DataType="vm:FleetViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="FLEET" Classes="eyebrow" />
                <TextBlock Text="Every machine in this data folder" Classes="h1" />
                <TextBlock Text="Technician mode: carry the portable app on a USB stick, scan each machine, and every scan lands in the same store on the stick. This page lists each machine's latest scan, lowest score first, with the worst component named, so the machine that needs attention is at the top. Machines scanned with the installed app can be brought in with Import JSON reports, which reads the JSON files the Report page exports. Export all machines writes one CSV per machine into the export folder, so the whole fleet can be filed at once instead of one Export click per row. To take a machine out of the fleet, use Remove on its row — it deletes all of that machine's saved scans from this data folder, in two clicks so a misclick cannot delete anything."
                           Classes="muted"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" IsVisible="{Binding HasFleet}" />
                    <Button Classes="secondary"
                            Content="Import JSON reports"
                            Command="{Binding ImportReportsCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="Imports TrueSpec JSON reports exported from other machines, so their scans join this fleet. A file that is not a TrueSpec report is skipped, and importing the same file twice stores one scan."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="720" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18" IsVisible="{Binding HasFleet}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <TextBlock Text="Machines" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="Export all machines"
                                Command="{Binding ExportAllMachinesCommand}"
                                IsEnabled="{Binding HasFleet}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="Export fleet as CSV"
                                Command="{Binding ExportFleetCsvCommand}"
                                IsEnabled="{Binding HasFleet}" />
                    </Grid>
                    <TextBlock Text="Lowest score first. A dash means that scan did not report the value."
                               Classes="muted"
                               FontSize="11" />
                    <Grid ColumnDefinitions="*,60,130,70,110,*,100,110" ColumnSpacing="10">
                        <TextBlock Text="Machine" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Scans" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="Last scan" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="Score" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="Verdict" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="5" Text="Worst component" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="6" Text="Export" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="7" Text="Remove" Classes="muted" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FleetRowViewModel">
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid ColumnDefinitions="*,60,130,70,110,*,100,110" ColumnSpacing="10">
                                        <TextBlock Text="{Binding MachineName}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScanCountText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding LastScanText}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ScoreText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding VerdictText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding WorstComponentText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="6"
                                                Classes="secondary"
                                                Content="Export CSV"
                                                FontSize="11"
                                                Command="{Binding ExportMachineCsvCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="7"
                                                Classes="secondary"
                                                Content="{Binding RemoveButtonText}"
                                                FontSize="11"
                                                Command="{Binding RemoveMachineCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
