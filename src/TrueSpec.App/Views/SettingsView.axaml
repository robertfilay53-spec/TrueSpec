<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:plugins="using:TrueSpec.Core.Plugins"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding SettingsEyebrowText}" Classes="eyebrow" />
                <TextBlock Text="{Binding SettingsTitleText}" Classes="h1" />
                <TextBlock Text="{Binding SettingsIntroText}"
                           Classes="muted" />
            </StackPanel>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppearanceTitleText}" Classes="h3" />
                        <TextBlock Text="{Binding ThemeText}" Classes="muted" />
                        <TextBlock Text="{Binding AppearanceNoteText}"
                                   Classes="muted"
                                   FontSize="11" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  OnContent="{Binding ThemeDarkText}"
                                  OffContent="{Binding ThemeLightText}"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RefreshTitleText}" Classes="h3" />
                        <TextBlock Text="{Binding RefreshNoteText}"
                                   Classes="muted"
                                   FontSize="11" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding RefreshRateOptions}"
                              SelectedValue="{Binding RefreshIntervalSeconds, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Value}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding LoggingTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding LoggingIntroText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecordTitleText}" Classes="h3" />
                            <TextBlock Text="{Binding RecordNoteText}"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding SensorLoggingEnabled, Mode=TwoWay}"
                                      OnContent="{Binding ToggleOnText}"
                                      OffContent="{Binding ToggleOffText}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlertTitleText}" Classes="h3" />
                            <TextBlock Text="{Binding AlertSummaryText}" Classes="muted" />
                            <TextBlock Text="{Binding AlertNoteText}"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding CpuTemperatureAlertEnabled, Mode=TwoWay}"
                                      OnContent="{Binding ToggleOnText}"
                                      OffContent="{Binding ToggleOffText}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="10" IsVisible="{Binding CpuTemperatureAlertEnabled}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding AlertAboveLabelText}" Classes="h3" />
                                <TextBox Text="{Binding CpuTemperatureThresholdText, Mode=TwoWay}"
                                         Width="120"
                                         HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding AlertDurationLabelText}" Classes="h3" />
                                <ComboBox Width="170"
                                          ItemsSource="{Binding ThresholdDurationOptions}"
                                          SelectedValue="{Binding CpuTemperatureThresholdSeconds, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Value}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ThresholdMessage}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HardwareDatabaseTitleText}" Classes="h3" />
                            <TextBlock Text="{Binding HardwareDatabaseNoteText}"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HardwareDatabaseVersionText}"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding HardwareDatabaseEnabled, Mode=TwoWay}"
                                      OnContent="{Binding ToggleOnText}"
                                      OffContent="{Binding ToggleOffText}"
                                      VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding ExportTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding ExportFolderText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="secondary"
                                Content="{Binding ExportChooseText}"
                                Command="{Binding PickExportFolderCommand}" />
                        <Button Classes="secondary"
                                Content="{Binding ExportResetText}"
                                Command="{Binding ResetExportFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FolderMessage}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ProblemBrush}" />
                    <TextBlock Text="{Binding ExportNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding DataLocationTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding PortableModeSummaryText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataFolderText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <Button Classes="secondary"
                            Content="{Binding PortableModeActionText}"
                            Command="{Binding TogglePortableModeCommand}" />
                    <TextBlock Text="{Binding PortableModeMessage}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Classes="muted" />
                    <TextBlock Text="{Binding DataLocationNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding PluginsTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding PluginsIntroText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PluginFolderText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PluginsSummaryText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DiscoveredPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="plugins:DiscoveredPlugin">
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,6">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayVersion}"
                                                       Classes="muted" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Reason}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="secondary"
                            Content="{Binding PluginsRefreshText}"
                            Command="{Binding RefreshPluginsCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding PluginsNotLoadedNoteText}"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LanguageTitleText}" Classes="h3" />
                        <TextBlock Text="{Binding LanguageDescriptionText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LanguageNoteText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding LanguageCode, Mode=TwoWay}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LanguageCodeToName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding PrivacyTitleText}" Classes="h3" />
                    <TextBlock Text="{Binding PrivacyText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
