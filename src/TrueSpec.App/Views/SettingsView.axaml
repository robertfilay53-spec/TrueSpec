<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrueSpec.App.ViewModels"
             xmlns:plugins="using:TrueSpec.Core.Plugins"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TrueSpec.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="SETTINGS" Classes="eyebrow" />
                <TextBlock Text="Settings" Classes="h1" />
                <TextBlock Text="Small, honest controls. Every change saves immediately and applies right away. Nothing here phones home."
                           Classes="muted" />
            </StackPanel>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Appearance" Classes="h3" />
                        <TextBlock Text="{Binding ThemeText}" Classes="muted" />
                        <TextBlock Text="Dark is the default theme. Light is available for bright rooms."
                                   Classes="muted"
                                   FontSize="11" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  OnContent="Dark"
                                  OffContent="Light"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Live sensor refresh rate" Classes="h3" />
                        <TextBlock Text="How often the live sensor strip re-reads. Faster is livelier; slower is calmer on the CPU."
                                   Classes="muted"
                                   FontSize="11" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding RefreshRateOptions}"
                              SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RefreshSecondsText}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sensor logging and alerts" Classes="h3" />
                    <TextBlock Text="Live sensor readings are recorded to a local CSV log while TrueSpec runs. The log never leaves this machine."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Record sensor readings" Classes="h3" />
                            <TextBlock Text="One row per sample, at the refresh rate above. A sensor that stops reporting leaves its cell empty, never a zero."
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding SensorLoggingEnabled, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="CPU temperature alert" Classes="h3" />
                            <TextBlock Text="{Binding AlertSummaryText}" Classes="muted" />
                            <TextBlock Text="TrueSpec ships with no alert set. The alert fires only after the temperature stays above your threshold for the full duration."
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding CpuTemperatureAlertEnabled, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="10" IsVisible="{Binding CpuTemperatureAlertEnabled}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Alert above (C)" Classes="h3" />
                                <TextBox Text="{Binding CpuTemperatureThresholdText, Mode=TwoWay}"
                                         Width="120"
                                         HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Must stay above for" Classes="h3" />
                                <ComboBox Width="170"
                                          ItemsSource="{Binding ThresholdDurationOptions}"
                                          SelectedItem="{Binding CpuTemperatureThresholdSeconds, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource RefreshSecondsText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ThresholdMessage}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Report export folder" Classes="h3" />
                    <TextBlock Text="{Binding ExportFolderText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="secondary"
                                Content="Choose folder..."
                                Command="{Binding PickExportFolderCommand}" />
                        <Button Classes="secondary"
                                Content="Reset to default"
                                Command="{Binding ResetExportFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FolderMessage}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ProblemBrush}" />
                    <TextBlock Text="JSON, HTML, CSV reports and the printable buyer checklist are saved here. Nothing is uploaded."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Data location (portable mode)" Classes="h3" />
                    <TextBlock Text="{Binding PortableModeSummaryText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataFolderText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <Button Classes="secondary"
                            Content="{Binding PortableModeActionText}"
                            Command="{Binding TogglePortableModeCommand}" />
                    <TextBlock Text="{Binding PortableModeMessage}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Classes="muted" />
                    <TextBlock Text="Takes effect after a restart. Scans already saved stay in the folder they were saved in; only new scans go to the new location."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Plug-ins" Classes="h3" />
                    <TextBlock Text="A plug-in adds a collector — a new hardware source — without changing TrueSpec. Put each plug-in in its own folder under the folder below. Every folder needs a plugin.json manifest that names the plug-in, the collector contract version it was written for, and the collectors it provides."
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PluginFolderText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PluginsSummaryText}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DiscoveredPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="plugins:DiscoveredPlugin">
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,6">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayVersion}"
                                                       Classes="muted" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Reason}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="secondary"
                            Content="Refresh plug-ins"
                            Command="{Binding RefreshPluginsCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="Plug-ins are discovered here but never loaded in this version: only signed plug-ins load, and plug-in signing is not set up yet."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LanguageTitleText}" Classes="h3" />
                        <TextBlock Text="{Binding LanguageDescriptionText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LanguageNoteText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding LanguageCode, Mode=TwoWay}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LanguageCodeToName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="Privacy" Classes="h3" />
                    <TextBlock Text="TrueSpec has no telemetry, no account, and no network calls. Scans stay on this machine. There is no update check and no startup registration: an offline app does not promise network features."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
