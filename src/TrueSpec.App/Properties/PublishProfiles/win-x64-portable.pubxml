<?xml version="1.0" encoding="utf-8"?>
<!--
  TrueSpec portable buyer-kit publish profile (v2.0 U7).

  Produces a self-contained, single-file win-x64 build in one folder:
  the .NET Desktop Runtime 10 is bundled inside TrueSpec.App.exe, so it
  runs from a USB stick on a machine with no .NET installed and no
  installer. Copy the whole publish folder to the stick and double-click
  TrueSpec.App.exe. The app manifest is asInvoker: it never asks for
  elevation, so a standard-user scan works (parts that need elevation
  read as "Not reported by hardware" instead of failing the scan).

  Publish from the repo root (on Windows):
    dotnet publish src/TrueSpec.App/TrueSpec.App.csproj -p:PublishProfile=win-x64-portable -o publish-portable

  Differences from win-x64.pubxml (the installer profile): none in the
  binary itself — the same single-file build. The profiles are separate
  so the installer and the buyer kit can evolve independently, and so a
  portable build is never mistaken for an installer input.

  Data location: with an empty file named TrueSpec.portable next to
  TrueSpec.App.exe (or the TRUESPEC_PORTABLE=1 environment variable),
  the app keeps its data beside the exe (settings.json, history.db,
  sensor-log.csv, startup.log, window-state.json) instead of under
  %LocalAppData%\TrueSpec; without the marker it behaves exactly as
  before. A portable root that fails validation falls back to the
  default folder instead of writing somewhere unsafe. History is
  keyed by machine name, not by machine identity, so one stick's
  history must never be read as proof about a different machine.

  PublishTrimmed is deliberately OFF: Avalonia and the collectors use
  reflection, and trimming would risk breaking the app at runtime.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No .pdb files in the portable folder: debug symbols would only
         bloat the USB stick for no benefit. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Drop every .pdb from the publish folder. The SkiaSharp/HarfBuzz
       packages ship .pdb files that the SDK copies to the publish output
       as content (CopyOutputSymbolsToPublishDirectory does not stop them);
       they would bloat the portable folder for no benefit. -->
  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- The buyer kit must work out of the box: the publish folder carries
       the portable marker, so copying the folder to a stick is enough and
       the buyer never has to create the marker by hand. The marker is
       written into the publish folder only, never into the repo, and
       only this profile does it: the installer profile must never ship
       a marker, or the installed app would keep its data next to the
       exe in the install folder instead of the default folder. -->
  <Target Name="WritePortableMarker" AfterTargets="Publish">
    <Touch Files="$(PublishDir)TrueSpec.portable" AlwaysCreate="true" />
  </Target>
</Project>
